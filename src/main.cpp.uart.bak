#include <Arduino.h>
#include "relay.h"

#define RXD2 16
#define TXD2 17

UARTRelayBoard relay(RXD2, TXD2);

void setup() {
  Serial.begin(9600);
  relay.begin();
  delay(1000);
  Serial.println("Relay UART test start");
}

void loop() {
  static uint8_t step = 0;
  static unsigned long lastStep = 0;

  const unsigned long ON_DUR  = 1000;
  const unsigned long OFF_DUR = 500;
  const unsigned long PAUSE   = 2000;
  const uint8_t TOTAL_STEPS   = 9;

  unsigned long now = millis();
  unsigned long wait = (step == 8) ? PAUSE : (step % 2 == 0 ? ON_DUR : OFF_DUR);

  if (now - lastStep >= wait) {
    lastStep = now;
    if (step < 8) {
      uint8_t ch    = (step / 2) + 1;
      bool    state = (step % 2 == 0);
      relay.control(ch, state);
    }
    step = (step + 1) % TOTAL_STEPS;
  }
}
